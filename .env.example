# --- Database (PostgreSQL) ---
# Local dev: a local Postgres. Production (Fly) supplies the Neon connection
# string as the secret NEON_PRODUCTION_DATABASE_URL, mapped to DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/puffping?schema=public"

# --- Twilio ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# PuffPing's approved Messaging Service (MG1dc1a3f40c323aabf6cf26770330a6da,
# A2P 10DLC campaign CM00d14a209e1c83c112c73c91d1e1eed5) is built in
# (src/lib/twilio.ts). On first boot it becomes "Campaign 1" in number-slot
# inventory (numbers already in its sender pool get free slots); further
# campaigns are added on /admin. Leave blank in production — set it only to
# point a dev/staging Twilio account at its own service.
TWILIO_MESSAGING_SERVICE_SID=""
# Public base URL of this app (used for Twilio webhooks), e.g. https://app.puffping.com
APP_BASE_URL="http://localhost:3000"

# --- Anthropic (AI copy assistant) ---
ANTHROPIC_API_KEY=""

# --- OpenAI (image "Optimize for Mobile" + 10DLC assist) ---
OPENAI_API_KEY=""
# Optional vision model override (default: gpt-4o-mini)
OPENAI_MODEL=""

# --- Media storage ---
# Directory for uploaded media. On Fly, mount a volume and point this at it so
# uploads persist across deploys (otherwise the machine's disk is ephemeral).
MEDIA_DIR=""

# --- Billing (Stripe, optional — the app runs on the free plan without it) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs for the paid plans
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
# Recurring $25/mo price for one number slot (one subscription per slot).
STRIPE_PRICE_NUMBER_SLOT=""

# --- Platform admin ---
# Comma-separated emails allowed to manage number-slot inventory at /admin.
PLATFORM_ADMIN_EMAILS=""

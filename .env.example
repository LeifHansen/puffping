# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Twilio ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Messaging Service used for campaign sends (created automatically by the
# 10DLC registration flow, or paste an existing SID here).
TWILIO_MESSAGING_SERVICE_SID=""
# Required for 10DLC secondary customer profiles (ISV flow): your approved
# primary customer profile SID and the TrustHub policy SIDs rarely change.
TWILIO_PRIMARY_PROFILE_SID=""
# Public base URL of this app (used for Twilio webhooks), e.g. https://app.puffping.com
APP_BASE_URL="http://localhost:3000"

# --- Anthropic (AI copy assistant) ---
ANTHROPIC_API_KEY=""

# --- OpenAI (image "Optimize for Mobile" + 10DLC assist) ---
OPENAI_API_KEY=""
# Optional vision model override (default: gpt-4o-mini)
OPENAI_MODEL=""

# --- Media storage ---
# Directory for uploaded media. On Fly, mount a volume and point this at it for
# durability across deploys (otherwise uploads are ephemeral, like dev.db).
MEDIA_DIR=""

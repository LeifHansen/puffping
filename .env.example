# --- Database (PostgreSQL) ---
# Local dev: a local Postgres. Production (Fly) supplies the Neon connection
# string as the secret NEON_PRODUCTION_DATABASE_URL, mapped to DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/puffping?schema=public"

# --- Twilio ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Messaging Service used for campaign sends (created automatically by the
# 10DLC registration flow, or paste an existing SID here).
TWILIO_MESSAGING_SERVICE_SID=""
# Required for 10DLC secondary customer profiles (ISV flow): your approved
# primary customer profile SID and the TrustHub policy SIDs rarely change.
TWILIO_PRIMARY_PROFILE_SID=""
# Public base URL of this app (used for Twilio webhooks), e.g. https://app.puffping.com
APP_BASE_URL="http://localhost:3000"

# --- Anthropic (AI copy assistant) ---
ANTHROPIC_API_KEY=""

# --- OpenAI (image "Optimize for Mobile" + 10DLC assist) ---
OPENAI_API_KEY=""
# Optional vision model override (default: gpt-4o-mini)
OPENAI_MODEL=""

# --- Media storage ---
# Directory for uploaded media. On Fly, mount a volume and point this at it so
# uploads persist across deploys (otherwise the machine's disk is ephemeral).
MEDIA_DIR=""

# --- Billing (Stripe, optional — the app runs on the free plan without it) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs for the paid plans
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
